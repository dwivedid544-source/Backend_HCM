# Database Connection (MySQL Database)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/hcm_db"

# JWT Secret Key (Used to sign login tokens)
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5001

# Frontend URL
CLIENT_URL=http://localhost:5173

# AI Server & API Credentials
AI_SERVER_URL=http://localhost:4000
OPENAI_API_KEY=your_openai_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=hcm-enterprise
PINECONE_ENVIRONMENT=us-east-1

# Cloudinary (Images: avatars, logos, profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ImageKit (Documents: resumes, PDFs, proofs)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
